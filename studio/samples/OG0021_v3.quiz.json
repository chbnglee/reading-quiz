  "story": {
    "storyId": "OG0021",
    "title": "Milo and the Lost Color",
    "level": "Level 2",
    "text": "SC01_ST01_N = Milo is a little chameleon.\nSC01_ST02_N = He loves to change colors–green, blue, red!\nSC02_ST01_N = But one morning, he wakes up gray.\nSC02_ST02_N = \"Oh no!\nSC02_ST03_N = Where is my color?\"\nSC02_ST04_N = Milo says.\nSC02_ST05_N = He looks at his tail.\nSC02_ST06_N = It's still gray.\nSC02_ST07_N = He feels sad and shy.\nSC03_ST01_N = Milo walks into the forest.\nSC03_ST02_N = He sees a yellow butterfly.\nSC03_ST03_N = \"Can I have your color?\" he asks.\nSC04_ST01_N = The butterfly smiles.\nSC04_ST02_N = \"My color helps me fly.\"\nSC04_ST03_N = Milo smiles back.\nSC04_ST04_N = \"Then I will keep looking.\"\nSC04_ST05_N = He waves goodbye.\nSC05_ST01_N = He meets a red flower.\nSC05_ST02_N = \"Can I have your color?\"\nSC05_ST03_N = Milo asks.\nSC05_ST04_N = The flower says, \"My color helps the bees find me.\"\nSC06_ST01_N = Milo is sad.\nSC06_ST02_N = \"Everyone has their own color.\"\nSC06_ST03_N = He sits by a blue pond.\nSC06_ST04_N = He cries.\nSC06_ST05_N = A tiny drop falls into the water.\nSC07_ST01_N = The pond shines!\nSC07_ST02_N = Milo sees many colors in the water–red, yellow, blue, green.\nSC07_ST03_N = They mix and dance like a rainbow.\nSC08_ST01_N = Milo laughs.\nSC08_ST02_N = \"Maybe my color is inside me!\"\nSC08_ST03_N = He takes a deep breath and closes his eyes.\nSC08_ST04_N = His body starts to glow.\nSC09_ST01_N = Green!\nSC09_ST02_N = Then blue!\nSC09_ST03_N = Then red again!\nSC09_ST04_N = Milo's colors come back, brighter than before.\nSC09_ST05_N = He feels happy and warm.\nSC10_ST01_N = Milo runs home.\nSC10_ST02_N = He looks in the mirror.\nSC10_ST03_N = \"I found my color.\nSC10_ST04_N = It's me!\" he says proudly.",
    "scenes": [
      {
        "sceneId": "SC01",
        "sentences": [
          {
            "sentenceId": "SC01_ST01_N",
            "text": "Milo is a little chameleon."
          },
          {
            "sentenceId": "SC01_ST02_N",
            "text": "He loves to change colors–green, blue, red!"
          }
        ]
      },
      {
        "sceneId": "SC02",
        "sentences": [
          {
            "sentenceId": "SC02_ST01_N",
            "text": "But one morning, he wakes up gray."
          },
          {
            "sentenceId": "SC02_ST02_N",
            "text": "\"Oh no!"
          },
          {
            "sentenceId": "SC02_ST03_N",
            "text": "Where is my color?\""
          },
          {
            "sentenceId": "SC02_ST04_N",
            "text": "Milo says."
          },
          {
            "sentenceId": "SC02_ST05_N",
            "text": "He looks at his tail."
          },
          {
            "sentenceId": "SC02_ST06_N",
            "text": "It's still gray."
          },
          {
            "sentenceId": "SC02_ST07_N",
            "text": "He feels sad and shy."
          }
        ]
      },
      {
        "sceneId": "SC03",
        "sentences": [
          {
            "sentenceId": "SC03_ST01_N",
            "text": "Milo walks into the forest."
          },
          {
            "sentenceId": "SC03_ST02_N",
            "text": "He sees a yellow butterfly."
          },
          {
            "sentenceId": "SC03_ST03_N",
            "text": "\"Can I have your color?\" he asks."
          }
        ]
      },
      {
        "sceneId": "SC04",
        "sentences": [
          {
            "sentenceId": "SC04_ST01_N",
            "text": "The butterfly smiles."
          },
          {
            "sentenceId": "SC04_ST02_N",
            "text": "\"My color helps me fly.\""
          },
          {
            "sentenceId": "SC04_ST03_N",
            "text": "Milo smiles back."
          },
          {
            "sentenceId": "SC04_ST04_N",
            "text": "\"Then I will keep looking.\""
          },
          {
            "sentenceId": "SC04_ST05_N",
            "text": "He waves goodbye."
          }
        ]
      },
      {
        "sceneId": "SC05",
        "sentences": [
          {
            "sentenceId": "SC05_ST01_N",
            "text": "He meets a red flower."
          },
          {
            "sentenceId": "SC05_ST02_N",
            "text": "\"Can I have your color?\""
          },
          {
            "sentenceId": "SC05_ST03_N",
            "text": "Milo asks."
          },
          {
            "sentenceId": "SC05_ST04_N",
            "text": "The flower says, \"My color helps the bees find me.\""
          }
        ]
      },
      {
        "sceneId": "SC06",
        "sentences": [
          {
            "sentenceId": "SC06_ST01_N",
            "text": "Milo is sad."
          },
          {
            "sentenceId": "SC06_ST02_N",
            "text": "\"Everyone has their own color.\""
          },
          {
            "sentenceId": "SC06_ST03_N",
            "text": "He sits by a blue pond."
          },
          {
            "sentenceId": "SC06_ST04_N",
            "text": "He cries."
          },
          {
            "sentenceId": "SC06_ST05_N",
            "text": "A tiny drop falls into the water."
          }
        ]
      },
      {
        "sceneId": "SC07",
        "sentences": [
          {
            "sentenceId": "SC07_ST01_N",
            "text": "The pond shines!"
          },
          {
            "sentenceId": "SC07_ST02_N",
            "text": "Milo sees many colors in the water–red, yellow, blue, green."
          },
          {
            "sentenceId": "SC07_ST03_N",
            "text": "They mix and dance like a rainbow."
          }
        ]
      },
      {
        "sceneId": "SC08",
        "sentences": [
          {
            "sentenceId": "SC08_ST01_N",
            "text": "Milo laughs."
          },
          {
            "sentenceId": "SC08_ST02_N",
            "text": "\"Maybe my color is inside me!\""
          },
          {
            "sentenceId": "SC08_ST03_N",
            "text": "He takes a deep breath and closes his eyes."
          },
          {
            "sentenceId": "SC08_ST04_N",
            "text": "His body starts to glow."
          }
        ]
      },
      {
        "sceneId": "SC09",
        "sentences": [
          {
            "sentenceId": "SC09_ST01_N",
            "text": "Green!"
          },
          {
            "sentenceId": "SC09_ST02_N",
            "text": "Then blue!"
          },
          {
            "sentenceId": "SC09_ST03_N",
            "text": "Then red again!"
          },
          {
            "sentenceId": "SC09_ST04_N",
            "text": "Milo's colors come back, brighter than before."
          },
          {
            "sentenceId": "SC09_ST05_N",
            "text": "He feels happy and warm."
          }
        ]
      },
      {
        "sceneId": "SC10",
        "sentences": [
          {
            "sentenceId": "SC10_ST01_N",
            "text": "Milo runs home."
          },
          {
            "sentenceId": "SC10_ST02_N",
            "text": "He looks in the mirror."
          },
          {
            "sentenceId": "SC10_ST03_N",
            "text": "\"I found my color."
          },
          {
            "sentenceId": "SC10_ST04_N",
            "text": "It's me!\" he says proudly."
          }
        ]
      }
    ]
  },
