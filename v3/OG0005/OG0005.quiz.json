  "story": {
    "storyId": "OG0005",
    "title": "The Rainbow Cloud in the Box",
    "level": "Level 4",
    "text": "SC01_ST01_N = On the quiet planet of Tiny Rock, two friends named Podo and Didi spent their evenings watching the universe.\nSC01_ST02_N = Between the two, Didi was always searching for excitement.\nSC02_ST01_N = Suddenly, an amazing rainbow cloud floated near their rock.\nSC02_ST02_N = It was a swirling cloud of stardust, glowing with vibrant shades of violet, orange, and emerald green.\nSC03_ST01_N = \"It is the most beautiful thing I have ever seen!\" exclaimed Didi.\nSC03_ST02_N = \"I must have it.\nSC03_ST03_N = I will capture a piece to keep on my shelf.\"\nSC04_ST01_N = Podo frowned gently.\nSC04_ST02_N = \"I do not think you can own a cloud, Didi,\" he warned.\nSC04_ST03_N = \"Its beauty comes from its movement.\"\nSC05_ST01_N = Ignoring his friend, Didi grabbed a net and caught a portion of the cloud in a clear crystal box.\nSC05_ST02_N = \"Got it!\" he shouted triumphantly.\nSC06_ST01_N = He rushed inside to display his treasure.\nSC06_ST02_N = But as he set the box down, the vibrant light began to dim.\nSC06_ST03_N = The swirling colors stopped moving.\nSC07_ST01_N = The captured cloud transformed before their eyes.\nSC07_ST02_N = It became a lifeless, dark gray clump of moisture, looking like a dirty raincloud.\nSC08_ST01_N = \"This is terrible,\" Didi groaned, tapping the glass.\nSC08_ST02_N = \"It looks like smoke.\nSC08_ST03_N = Where did the magic go?\"\nSC09_ST01_N = \"The magic was in the freedom,\" Podo said wisely.\nSC09_ST02_N = \"By trapping it, you extinguished its light.\nSC09_ST03_N = Its light died when it cannot move.\"\nSC10_ST01_N = Didi realized his mistake.\nSC10_ST02_N = He looked at the dull box and then at the vast, open sky.\nSC10_ST03_N = He picked up the box and ran back outside.\nSC11_ST01_N = With a hopeful heart, Didi opened the crystal box.\nSC11_ST02_N = The gray puff floated slowly out into the sky.\nSC12_ST01_N = Instantly, the open sky brought it back to life.\nSC12_ST02_N = The gray turned back to brilliant violet, orange, and emerald.\nSC12_ST03_N = It joined the rest of the cloud, swirling happily.\nSC13_ST01_N = \"It is a masterpiece again,\" Didi whispered, watching it drift away.\nSC13_ST02_N = \"Indeed,\" agreed Podo.\nSC13_ST03_N = \"And now it is where it belongs.\nSC13_ST04_N = That is the most beautiful thing of all.\"\nSC13_ST05_N = They watched it fly freely and smiled.",
    "scenes": [
      {
        "sceneId": "SC01",
        "sentences": [
          {
            "sentenceId": "SC01_ST01_N",
            "text": "On the quiet planet of Tiny Rock, two friends named Podo and Didi spent their evenings watching the universe."
          },
          {
            "sentenceId": "SC01_ST02_N",
            "text": "Between the two, Didi was always searching for excitement."
          }
        ]
      },
      {
        "sceneId": "SC02",
        "sentences": [
          {
            "sentenceId": "SC02_ST01_N",
            "text": "Suddenly, an amazing rainbow cloud floated near their rock."
          },
          {
            "sentenceId": "SC02_ST02_N",
            "text": "It was a swirling cloud of stardust, glowing with vibrant shades of violet, orange, and emerald green."
          }
        ]
      },
      {
        "sceneId": "SC03",
        "sentences": [
          {
            "sentenceId": "SC03_ST01_N",
            "text": "\"It is the most beautiful thing I have ever seen!\" exclaimed Didi."
          },
          {
            "sentenceId": "SC03_ST02_N",
            "text": "\"I must have it."
          },
          {
            "sentenceId": "SC03_ST03_N",
            "text": "I will capture a piece to keep on my shelf.\""
          }
        ]
      },
      {
        "sceneId": "SC04",
        "sentences": [
          {
            "sentenceId": "SC04_ST01_N",
            "text": "Podo frowned gently."
          },
          {
            "sentenceId": "SC04_ST02_N",
            "text": "\"I do not think you can own a cloud, Didi,\" he warned."
          },
          {
            "sentenceId": "SC04_ST03_N",
            "text": "\"Its beauty comes from its movement.\""
          }
        ]
      },
      {
        "sceneId": "SC05",
        "sentences": [
          {
            "sentenceId": "SC05_ST01_N",
            "text": "Ignoring his friend, Didi grabbed a net and caught a portion of the cloud in a clear crystal box."
          },
          {
            "sentenceId": "SC05_ST02_N",
            "text": "\"Got it!\" he shouted triumphantly."
          }
        ]
      },
      {
        "sceneId": "SC06",
        "sentences": [
          {
            "sentenceId": "SC06_ST01_N",
            "text": "He rushed inside to display his treasure."
          },
          {
            "sentenceId": "SC06_ST02_N",
            "text": "But as he set the box down, the vibrant light began to dim."
          },
          {
            "sentenceId": "SC06_ST03_N",
            "text": "The swirling colors stopped moving."
          }
        ]
      },
      {
        "sceneId": "SC07",
        "sentences": [
          {
            "sentenceId": "SC07_ST01_N",
            "text": "The captured cloud transformed before their eyes."
          },
          {
            "sentenceId": "SC07_ST02_N",
            "text": "It became a lifeless, dark gray clump of moisture, looking like a dirty raincloud."
          }
        ]
      },
      {
        "sceneId": "SC08",
        "sentences": [
          {
            "sentenceId": "SC08_ST01_N",
            "text": "\"This is terrible,\" Didi groaned, tapping the glass."
          },
          {
            "sentenceId": "SC08_ST02_N",
            "text": "\"It looks like smoke."
          },
          {
            "sentenceId": "SC08_ST03_N",
            "text": "Where did the magic go?\""
          }
        ]
      },
      {
        "sceneId": "SC09",
        "sentences": [
          {
            "sentenceId": "SC09_ST01_N",
            "text": "\"The magic was in the freedom,\" Podo said wisely."
          },
          {
            "sentenceId": "SC09_ST02_N",
            "text": "\"By trapping it, you extinguished its light."
          },
          {
            "sentenceId": "SC09_ST03_N",
            "text": "Its light died when it cannot move.\""
          }
        ]
      },
      {
        "sceneId": "SC10",
        "sentences": [
          {
            "sentenceId": "SC10_ST01_N",
            "text": "Didi realized his mistake."
          },
          {
            "sentenceId": "SC10_ST02_N",
            "text": "He looked at the dull box and then at the vast, open sky."
          },
          {
            "sentenceId": "SC10_ST03_N",
            "text": "He picked up the box and ran back outside."
          }
        ]
      },
      {
        "sceneId": "SC11",
        "sentences": [
          {
            "sentenceId": "SC11_ST01_N",
            "text": "With a hopeful heart, Didi opened the crystal box."
          },
          {
            "sentenceId": "SC11_ST02_N",
            "text": "The gray puff floated slowly out into the sky."
          }
        ]
      },
      {
        "sceneId": "SC12",
        "sentences": [
          {
            "sentenceId": "SC12_ST01_N",
            "text": "Instantly, the open sky brought it back to life."
          },
          {
            "sentenceId": "SC12_ST02_N",
            "text": "The gray turned back to brilliant violet, orange, and emerald."
          },
          {
            "sentenceId": "SC12_ST03_N",
            "text": "It joined the rest of the cloud, swirling happily."
          }
        ]
      },
      {
        "sceneId": "SC13",
        "sentences": [
          {
            "sentenceId": "SC13_ST01_N",
            "text": "\"It is a masterpiece again,\" Didi whispered, watching it drift away."
          },
          {
            "sentenceId": "SC13_ST02_N",
            "text": "\"Indeed,\" agreed Podo."
          },
          {
            "sentenceId": "SC13_ST03_N",
            "text": "\"And now it is where it belongs."
          },
          {
            "sentenceId": "SC13_ST04_N",
            "text": "That is the most beautiful thing of all.\""
          },
          {
            "sentenceId": "SC13_ST05_N",
            "text": "They watched it fly freely and smiled."
          }
        ]
      }
    ]
  },
