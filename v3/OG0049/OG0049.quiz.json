    "storyId": "OG0049",
    "title": "The Mystery of the Deep: The Lost Light",
    "level": "Level 3",
    "text": "SC01_ST01_N = Deep, deep below, the ocean was as black as ink.\nSC01_ST02_N = No sunlight could reach this world.\nSC02_ST01_N = \"Look there!\"\nSC02_ST02_N = Captain Kira pointed.\nSC02_ST03_N = A tiny golden light moved through the sea snow.\nSC03_ST01_N = Beside her, Toby the young diver pressed his face to the glass.\nSC03_ST02_N = \"It's moving!\"\nSC04_ST01_N = The Aurora submarine turned toward the strange light.\nSC04_ST02_N = It followed the light into the dark canyon.\nSC05_ST01_N = It was an anglerfish, the queen of the deep.\nSC05_ST02_N = But her magic lamp was fading.\nSC06_ST01_N = A thick plastic bag covered her head.\nSC06_ST02_N = It dimmed her glowing light.\nSC07_ST01_N = The fish bumped into rocks.\nSC07_ST02_N = She was lost and hungry because of all the drifting waste.\nSC08_ST01_N = Suddenly, a strong current pulled the fish.\nSC08_ST02_N = She was heading toward a jagged cave!\nSC09_ST01_N = \"We must act now!\"\nSC09_ST02_N = Captain Kira cried.\nSC09_ST03_N = Diver Toby opened the submarine's silver robot arms.\nSC10_ST01_N = The submarine shook in the wild water.\nSC10_ST02_N = \"Hold on!\"\nSC10_ST03_N = Toby said.\nSC10_ST04_N = Kira held the wheel tight.\nSC11_ST01_N = The robot arm moved like a dancer.\nSC11_ST02_N = It reached out and caught the edge of the bag.\nSC12_ST01_N = With a soft tug, the plastic bag came off.\nSC12_ST02_N = The machine collected the dangerous waste.\nSC13_ST01_N = Instantly, the fish's lamp shone like a star.\nSC13_ST02_N = The darkness faded away in a golden glow.\nSC14_ST01_N = The anglerfish wiggled her fins.\nSC14_ST02_N = She looked at the submarine as if saying, \"Thank you.\"\nSC15_ST01_N = \"Her light is back,\" Kira whispered.\nSC15_ST02_N = Toby smiled at the glowing sea.\nSC16_ST01_N = The Aurora moved on to the next job.\nSC16_ST02_N = One small light was enough to light the way.",
    "scenes": [
      {
        "sceneId": "SC01",
        "sentences": [
          {
            "sentenceId": "SC01_ST01_N",
            "text": "Deep, deep below, the ocean was as black as ink."
          },
          {
            "sentenceId": "SC01_ST02_N",
            "text": "No sunlight could reach this world."
          }
        ]
      },
      {
        "sceneId": "SC02",
        "sentences": [
          {
            "sentenceId": "SC02_ST01_N",
            "text": "\"Look there!\""
          },
          {
            "sentenceId": "SC02_ST02_N",
            "text": "Captain Kira pointed."
          },
          {
            "sentenceId": "SC02_ST03_N",
            "text": "A tiny golden light moved through the sea snow."
          }
        ]
      },
      {
        "sceneId": "SC03",
        "sentences": [
          {
            "sentenceId": "SC03_ST01_N",
            "text": "Beside her, Toby the young diver pressed his face to the glass."
          },
          {
            "sentenceId": "SC03_ST02_N",
            "text": "\"It's moving!\""
          }
        ]
      },
      {
        "sceneId": "SC04",
        "sentences": [
          {
            "sentenceId": "SC04_ST01_N",
            "text": "The Aurora submarine turned toward the strange light."
          },
          {
            "sentenceId": "SC04_ST02_N",
            "text": "It followed the light into the dark canyon."
          }
        ]
      },
      {
        "sceneId": "SC05",
        "sentences": [
          {
            "sentenceId": "SC05_ST01_N",
            "text": "It was an anglerfish, the queen of the deep."
          },
          {
            "sentenceId": "SC05_ST02_N",
            "text": "But her magic lamp was fading."
          }
        ]
      },
      {
        "sceneId": "SC06",
        "sentences": [
          {
            "sentenceId": "SC06_ST01_N",
            "text": "A thick plastic bag covered her head."
          },
          {
            "sentenceId": "SC06_ST02_N",
            "text": "It dimmed her glowing light."
          }
        ]
      },
      {
        "sceneId": "SC07",
        "sentences": [
          {
            "sentenceId": "SC07_ST01_N",
            "text": "The fish bumped into rocks."
          },
          {
            "sentenceId": "SC07_ST02_N",
            "text": "She was lost and hungry because of all the drifting waste."
          }
        ]
      },
      {
        "sceneId": "SC08",
        "sentences": [
          {
            "sentenceId": "SC08_ST01_N",
            "text": "Suddenly, a strong current pulled the fish."
          },
          {
            "sentenceId": "SC08_ST02_N",
            "text": "She was heading toward a jagged cave!"
          }
        ]
      },
      {
        "sceneId": "SC09",
        "sentences": [
          {
            "sentenceId": "SC09_ST01_N",
            "text": "\"We must act now!\""
          },
          {
            "sentenceId": "SC09_ST02_N",
            "text": "Captain Kira cried."
          },
          {
            "sentenceId": "SC09_ST03_N",
            "text": "Diver Toby opened the submarine's silver robot arms."
          }
        ]
      },
      {
        "sceneId": "SC10",
        "sentences": [
          {
            "sentenceId": "SC10_ST01_N",
            "text": "The submarine shook in the wild water."
          },
          {
            "sentenceId": "SC10_ST02_N",
            "text": "\"Hold on!\""
          },
          {
            "sentenceId": "SC10_ST03_N",
            "text": "Toby said."
          },
          {
            "sentenceId": "SC10_ST04_N",
            "text": "Kira held the wheel tight."
          }
        ]
      },
      {
        "sceneId": "SC11",
        "sentences": [
          {
            "sentenceId": "SC11_ST01_N",
            "text": "The robot arm moved like a dancer."
          },
          {
            "sentenceId": "SC11_ST02_N",
            "text": "It reached out and caught the edge of the bag."
          }
        ]
      },
      {
        "sceneId": "SC12",
        "sentences": [
          {
            "sentenceId": "SC12_ST01_N",
            "text": "With a soft tug, the plastic bag came off."
          },
          {
            "sentenceId": "SC12_ST02_N",
            "text": "The machine collected the dangerous waste."
          }
        ]
      },
      {
        "sceneId": "SC13",
        "sentences": [
          {
            "sentenceId": "SC13_ST01_N",
            "text": "Instantly, the fish's lamp shone like a star."
          },
          {
            "sentenceId": "SC13_ST02_N",
            "text": "The darkness faded away in a golden glow."
          }
        ]
      },
      {
        "sceneId": "SC14",
        "sentences": [
          {
            "sentenceId": "SC14_ST01_N",
            "text": "The anglerfish wiggled her fins."
          },
          {
            "sentenceId": "SC14_ST02_N",
            "text": "She looked at the submarine as if saying, \"Thank you.\""
          }
        ]
      },
      {
        "sceneId": "SC15",
        "sentences": [
          {
            "sentenceId": "SC15_ST01_N",
            "text": "\"Her light is back,\" Kira whispered."
          },
          {
            "sentenceId": "SC15_ST02_N",
            "text": "Toby smiled at the glowing sea."
          }
        ]
      },
      {
        "sceneId": "SC16",
        "sentences": [
          {
            "sentenceId": "SC16_ST01_N",
            "text": "The Aurora moved on to the next job."
          },
          {
            "sentenceId": "SC16_ST02_N",
            "text": "One small light was enough to light the way."
          }
        ]
      }
    ]
