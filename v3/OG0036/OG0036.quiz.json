  "story": {
    "storyId": "OG0036",
    "title": "The Secret of Judy's Silver Racket",
    "level": "Level 3",
    "text": "SC01_ST01_N = Judy loved tennis, but she was always nervous.\nSC01_ST02_N = During big matches, her legs were shaking.\nSC01_ST03_N = She often lost games because of her fear.\nSC02_ST01_N = One day, Judy found a shop called Jingle Jump.\nSC02_ST02_N = Mr. Jing, the owner, gave her a shimmering silver racket.\nSC02_ST03_N = \"This racket will guide you,\" he said.\nSC03_ST01_N = The next day, Judy went to the court.\nSC03_ST02_N = Suddenly, she heard a tiny whisper from the racket.\nSC03_ST03_N = \"Move right!\nSC03_ST04_N = Hit now!\" the whisper said clearly.\nSC04_ST01_N = Judy followed the whisper.\nSC04_ST02_N = She hit the ball perfectly.\nSC04_ST03_N = She was surprised and very happy.\nSC04_ST04_N = It was a winning shot.\nSC05_ST01_N = With the silver racket, Judy won many matches.\nSC05_ST02_N = She became well-known in her town.\nSC05_ST03_N = However, she stopped practicing hard.\nSC05_ST04_N = She only waited for the whispers.\nSC06_ST01_N = Soon, Judy reached the championship finals.\nSC06_ST02_N = Her opponent was Bella.\nSC06_ST03_N = Bella was the best player and had very fast serves.\nSC06_ST04_N = The whole stadium was filled with nervous excitement.\nSC07_ST01_N = In the first set, Judy played well.\nSC07_ST02_N = The silver racket told her what to do.\nSC07_ST03_N = Judy felt like a star.\nSC07_ST04_N = Bella was surprised by Judy's play.\nSC08_ST01_N = During the second set, however, Judy tripped and fell.\nSC08_ST02_N = The silver racket hit the ground.\nSC08_ST03_N = It broke into two pieces.\nSC08_ST04_N = Judy was shocked.\nSC09_ST01_N = The magical whispers stopped.\nSC09_ST02_N = Judy felt scared and alone.\nSC09_ST03_N = \"I can't win without the whispers,\" she thought.\nSC09_ST04_N = She started to lose many points.\nSC10_ST01_N = During the break, Judy sat on the bench.\nSC10_ST02_N = She looked at her old, scratched racket in her bag.\nSC10_ST03_N = It looked very dull and old.\nSC11_ST01_N = She gripped the handle.\nSC11_ST02_N = She saw the worn tape.\nSC11_ST03_N = She remembered her long hours of practice.\nSC11_ST04_N = Her hands were sore from working so hard.\nSC12_ST01_N = Judy realized something important.\nSC12_ST02_N = The whispers were not magic.\nSC12_ST03_N = They were her own instincts.\nSC12_ST04_N = She had learned them through many months of practice.\nSC13_ST01_N = \"The strength is inside me,\" Judy said.\nSC13_ST02_N = She stood up and held her old racket tightly.\nSC13_ST03_N = She did not need the silver racket anymore.\nSC14_ST01_N = Judy returned to the court.\nSC14_ST02_N = She played with her own rhythm.\nSC14_ST03_N = She was not nervous anymore.\nSC14_ST04_N = She moved fast and hit the ball with power.\nSC15_ST01_N = The match was very close.\nSC15_ST02_N = In the end, Bella won by a little.\nSC15_ST03_N = Bella smiled and said, \"That was a great game, Judy!\"\nSC16_ST01_N = Judy was happy.\nSC16_ST02_N = She lost the trophy, but she found her confidence.\nSC16_ST03_N = She knew she could play well with her own strength.",
    "scenes": [
      {
        "sceneId": "SC01",
        "sentences": [
          {
            "sentenceId": "SC01_ST01_N",
            "text": "Judy loved tennis, but she was always nervous."
          },
          {
            "sentenceId": "SC01_ST02_N",
            "text": "During big matches, her legs were shaking."
          },
          {
            "sentenceId": "SC01_ST03_N",
            "text": "She often lost games because of her fear."
          }
        ]
      },
      {
        "sceneId": "SC02",
        "sentences": [
          {
            "sentenceId": "SC02_ST01_N",
            "text": "One day, Judy found a shop called Jingle Jump."
          },
          {
            "sentenceId": "SC02_ST02_N",
            "text": "Mr. Jing, the owner, gave her a shimmering silver racket."
          },
          {
            "sentenceId": "SC02_ST03_N",
            "text": "\"This racket will guide you,\" he said."
          }
        ]
      },
      {
        "sceneId": "SC03",
        "sentences": [
          {
            "sentenceId": "SC03_ST01_N",
            "text": "The next day, Judy went to the court."
          },
          {
            "sentenceId": "SC03_ST02_N",
            "text": "Suddenly, she heard a tiny whisper from the racket."
          },
          {
            "sentenceId": "SC03_ST03_N",
            "text": "\"Move right!"
          },
          {
            "sentenceId": "SC03_ST04_N",
            "text": "Hit now!\" the whisper said clearly."
          }
        ]
      },
      {
        "sceneId": "SC04",
        "sentences": [
          {
            "sentenceId": "SC04_ST01_N",
            "text": "Judy followed the whisper."
          },
          {
            "sentenceId": "SC04_ST02_N",
            "text": "She hit the ball perfectly."
          },
          {
            "sentenceId": "SC04_ST03_N",
            "text": "She was surprised and very happy."
          },
          {
            "sentenceId": "SC04_ST04_N",
            "text": "It was a winning shot."
          }
        ]
      },
      {
        "sceneId": "SC05",
        "sentences": [
          {
            "sentenceId": "SC05_ST01_N",
            "text": "With the silver racket, Judy won many matches."
          },
          {
            "sentenceId": "SC05_ST02_N",
            "text": "She became well-known in her town."
          },
          {
            "sentenceId": "SC05_ST03_N",
            "text": "However, she stopped practicing hard."
          },
          {
            "sentenceId": "SC05_ST04_N",
            "text": "She only waited for the whispers."
          }
        ]
      },
      {
        "sceneId": "SC06",
        "sentences": [
          {
            "sentenceId": "SC06_ST01_N",
            "text": "Soon, Judy reached the championship finals."
          },
          {
            "sentenceId": "SC06_ST02_N",
            "text": "Her opponent was Bella."
          },
          {
            "sentenceId": "SC06_ST03_N",
            "text": "Bella was the best player and had very fast serves."
          },
          {
            "sentenceId": "SC06_ST04_N",
            "text": "The whole stadium was filled with nervous excitement."
          }
        ]
      },
      {
        "sceneId": "SC07",
        "sentences": [
          {
            "sentenceId": "SC07_ST01_N",
            "text": "In the first set, Judy played well."
          },
          {
            "sentenceId": "SC07_ST02_N",
            "text": "The silver racket told her what to do."
          },
          {
            "sentenceId": "SC07_ST03_N",
            "text": "Judy felt like a star."
          },
          {
            "sentenceId": "SC07_ST04_N",
            "text": "Bella was surprised by Judy's play."
          }
        ]
      },
      {
        "sceneId": "SC08",
        "sentences": [
          {
            "sentenceId": "SC08_ST01_N",
            "text": "During the second set, however, Judy tripped and fell."
          },
          {
            "sentenceId": "SC08_ST02_N",
            "text": "The silver racket hit the ground."
          },
          {
            "sentenceId": "SC08_ST03_N",
            "text": "It broke into two pieces."
          },
          {
            "sentenceId": "SC08_ST04_N",
            "text": "Judy was shocked."
          }
        ]
      },
      {
        "sceneId": "SC09",
        "sentences": [
          {
            "sentenceId": "SC09_ST01_N",
            "text": "The magical whispers stopped."
          },
          {
            "sentenceId": "SC09_ST02_N",
            "text": "Judy felt scared and alone."
          },
          {
            "sentenceId": "SC09_ST03_N",
            "text": "\"I can't win without the whispers,\" she thought."
          },
          {
            "sentenceId": "SC09_ST04_N",
            "text": "She started to lose many points."
          }
        ]
      },
      {
        "sceneId": "SC10",
        "sentences": [
          {
            "sentenceId": "SC10_ST01_N",
            "text": "During the break, Judy sat on the bench."
          },
          {
            "sentenceId": "SC10_ST02_N",
            "text": "She looked at her old, scratched racket in her bag."
          },
          {
            "sentenceId": "SC10_ST03_N",
            "text": "It looked very dull and old."
          }
        ]
      },
      {
        "sceneId": "SC11",
        "sentences": [
          {
            "sentenceId": "SC11_ST01_N",
            "text": "She gripped the handle."
          },
          {
            "sentenceId": "SC11_ST02_N",
            "text": "She saw the worn tape."
          },
          {
            "sentenceId": "SC11_ST03_N",
            "text": "She remembered her long hours of practice."
          },
          {
            "sentenceId": "SC11_ST04_N",
            "text": "Her hands were sore from working so hard."
          }
        ]
      },
      {
        "sceneId": "SC12",
        "sentences": [
          {
            "sentenceId": "SC12_ST01_N",
            "text": "Judy realized something important."
          },
          {
            "sentenceId": "SC12_ST02_N",
            "text": "The whispers were not magic."
          },
          {
            "sentenceId": "SC12_ST03_N",
            "text": "They were her own instincts."
          },
          {
            "sentenceId": "SC12_ST04_N",
            "text": "She had learned them through many months of practice."
          }
        ]
      },
      {
        "sceneId": "SC13",
        "sentences": [
          {
            "sentenceId": "SC13_ST01_N",
            "text": "\"The strength is inside me,\" Judy said."
          },
          {
            "sentenceId": "SC13_ST02_N",
            "text": "She stood up and held her old racket tightly."
          },
          {
            "sentenceId": "SC13_ST03_N",
            "text": "She did not need the silver racket anymore."
          }
        ]
      },
      {
        "sceneId": "SC14",
        "sentences": [
          {
            "sentenceId": "SC14_ST01_N",
            "text": "Judy returned to the court."
          },
          {
            "sentenceId": "SC14_ST02_N",
            "text": "She played with her own rhythm."
          },
          {
            "sentenceId": "SC14_ST03_N",
            "text": "She was not nervous anymore."
          },
          {
            "sentenceId": "SC14_ST04_N",
            "text": "She moved fast and hit the ball with power."
          }
        ]
      },
      {
        "sceneId": "SC15",
        "sentences": [
          {
            "sentenceId": "SC15_ST01_N",
            "text": "The match was very close."
          },
          {
            "sentenceId": "SC15_ST02_N",
            "text": "In the end, Bella won by a little."
          },
          {
            "sentenceId": "SC15_ST03_N",
            "text": "Bella smiled and said, \"That was a great game, Judy!\""
          }
        ]
      },
      {
        "sceneId": "SC16",
        "sentences": [
          {
            "sentenceId": "SC16_ST01_N",
            "text": "Judy was happy."
          },
          {
            "sentenceId": "SC16_ST02_N",
            "text": "She lost the trophy, but she found her confidence."
          },
          {
            "sentenceId": "SC16_ST03_N",
            "text": "She knew she could play well with her own strength."
          }
        ]
      }
    ]
  },
